@model onlineShop.DTOs.CommandeDTO
@{
    ViewData["Title"] = "Commande confirmée";
}

<section class="py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow text-center">
                    <div class="card-body p-5">
                        <div class="text-success mb-4">
                            <i class="fas fa-check-circle fa-5x"></i>
                        </div>
                        <h1 class="text-success">Commande confirmée !</h1>
                        <p class="lead">Merci pour votre commande</p>

                        <div class="alert alert-info my-4">
                            <h4>Commande N° @Model.Idcmd</h4>
                            <p class="mb-0">Date: @Model.DateCmd.ToString("dd/MM/yyyy à HH:mm")</p>
                        </div>

                        <div class="row text-start mb-4">
                            <div class="col-md-6">
                                <h5><i class="fas fa-box"></i> Articles commandés</h5>
                                <ul class="list-unstyled">
                                    @foreach (var ligne in Model.Lignes)
                                    {
                                        <li>
                                            <small class="text-muted">x @ligne.Qte</small>
                                        </li>
                                    }
                                </ul>
                            </div>
                            <div class="col-md-6">
                                <h5><i class="fas fa-credit-card"></i> Montant total</h5>
                                <p class="fs-3 fw-bold text-primary">@Model.TotalTTC?.ToString("F2") DT</p>
                            </div>
                        </div>

                        <div class="alert alert-warning">
                            <i class="fas fa-info-circle"></i>
                            Vous recevrez un email de confirmation à l'adresse: <strong>@User.Identity.Name</strong>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <a asp-controller="Client" asp-action="MesCommandes" class="btn btn-primary btn-lg">
                                <i class="fas fa-list"></i> Voir mes commandes
                            </a>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                                <i class="fas fa-home"></i> Retour à l'accueil
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>