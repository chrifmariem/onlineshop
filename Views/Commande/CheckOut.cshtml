@model onlineShop.DTOs.CommandeDTO
@{
    ViewData["Title"] = "Finaliser ma commande";
}

<section class="py-5">
    <div class="container">
        <h1 class="mb-4">
            <i class="fas fa-shopping-bag"></i> Finaliser ma commande
        </h1>

        <div class="row">
            <!-- LEFT : Livraison -->
            <div class="col-lg-8">
                <div class="card shadow mb-4">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0">
                            <i class="fas fa-truck"></i> Informations de livraison
                        </h5>
                    </div>

                    <div class="card-body">
                        <form asp-action="Create" method="post">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Nom complet</label>
                                    <input type="text"
                                           name="NomComplet"
                                           class="form-control"
                                           value="@ViewBag.Client?.NomComplet"
                                           required />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Téléphone</label>
                                    <input type="tel"
                                           name="Telephone"
                                           class="form-control"
                                           value="@ViewBag.Client?.Telephone"
                                           required />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Adresse de livraison</label>
                                <textarea name="Adresse"
                                          class="form-control"
                                          rows="3"
                                          required>@ViewBag.Client?.Adresse</textarea>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Notes de commande (optionnel)</label>
                                <textarea name="Notes"
                                          class="form-control"
                                          rows="2"
                                          placeholder="Instructions spéciales..."></textarea>
                            </div>

                            <div class="form-check mb-3">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="accepteConditions"
                                       required />
                                <label class="form-check-label" for="accepteConditions">
                                    J'accepte les
                                    <a href="#" target="_blank">conditions générales de vente</a>
                                </label>
                            </div>

                            <button type="submit" class="btn btn-success btn-lg w-100">
                                <i class="fas fa-check-circle"></i> Confirmer la commande
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- RIGHT : Résumé commande -->
            <div class="col-lg-4">
                <div class="card shadow sticky-top" style="top:20px;">
                    <div class="card-header bg-light">
                        <h5 class="mb-0">Résumé de la commande</h5>
                    </div>

                    <div class="card-body">
                        @if (ViewBag.Panier != null && ViewBag.Panier.Items != null)
                        {
                            @foreach (var item in ViewBag.Panier.Items)
                            {
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="me-2">
                                        <div class="fw-semibold">
                                            @item.NomProduit
                                        </div>
                                        <small class="text-muted">
                                            x @item.Quantite
                                        </small>
                                    </div>

                                    <div class="fw-semibold">
                                        @item.SousTotal.ToString("0.00") DT
                                    </div>
                                </div>
                            }

                            <hr />

                            <div class="d-flex justify-content-between mb-2">
                                <span>Sous-total :</span>
                                <span>@ViewBag.Panier.TotalHT.ToString("0.00") DT</span>
                            </div>

                            <div class="d-flex justify-content-between mb-2">
                                <span>TVA :</span>
                                <span>@ViewBag.Panier.TotalTVA.ToString("0.00") DT</span>
                            </div>

                            <div class="d-flex justify-content-between mb-2 text-success">
                                <span>Livraison :</span>
                                <span>GRATUITE</span>
                            </div>

                            <hr />

                            <div class="d-flex justify-content-between align-items-center">
                                <strong>Total :</strong>
                                <strong class="text-primary fs-4">
                                    @ViewBag.Panier.TotalTTC.ToString("0.00") DT
                                </strong>
                            </div>
                        }
                        else
                        {
                            <p class="text-muted text-center mb-0">
                                Votre panier est vide
                            </p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
