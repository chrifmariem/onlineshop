@model onlineShop.DTOs.ChangerMotpasseDto

@{
    var isAdmin = User.IsInRole("admin");
    var btnClass = isAdmin ? "btn-danger" : "btn-primary";
}

<form asp-controller="Account" asp-action="ChangePassword" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <div class="mb-4">
        <label asp-for="CurrentPassword" class="form-label fw-bold">
            <i class="fas fa-lock"></i> Ancien mot de passe *
        </label>
        <input asp-for="CurrentPassword" type="password" class="form-control form-control-lg" />
        <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="NewPassword" class="form-label fw-bold">
            <i class="fas fa-lock"></i> Nouveau mot de passe *
        </label>
        <input asp-for="NewPassword" type="password" class="form-control form-control-lg" />
        <span asp-validation-for="NewPassword" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmNewPassword" class="form-label fw-bold">
            <i class="fas fa-lock"></i> Confirmer le nouveau mot de passe *
        </label>
        <input asp-for="ConfirmNewPassword" type="password" class="form-control form-control-lg" />
        <span asp-validation-for="ConfirmNewPassword" class="text-danger small"></span>
    </div>

    @if (isAdmin)
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle"></i>
            <strong>Attention Admin:</strong> Vous serez déconnecté après le changement de mot de passe pour des raisons de sécurité.
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            Vous resterez connecté après le changement de mot de passe.
        </div>
    }

    <button type="submit" class="btn @btnClass btn-lg w-100">
        <i class="fas fa-check"></i> Changer le mot de passe
    </button>
</form>