@model onlineShop.DTOs.ChangerMotpasseDto
@{
    ViewData["Title"] = "Changer le mot de passe";

    // Detect user type for styling
    var isAdmin = User.IsInRole("admin");
    var btnClass = isAdmin ? "btn-danger" : "btn-primary";
    var iconClass = isAdmin ? "fa-user-shield" : "fa-key";
    var title = isAdmin ? "Sécurité Admin - Changer le mot de passe" : "Changer mon mot de passe";
    var returnUrl = isAdmin ? Url.Action("Dashboard", "Admin") : Url.Action("Profile", "Client");
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow">
                <div class="card-header @(isAdmin ? "bg-danger text-white" : "bg-primary text-white")">
                    <h4 class="mb-0"><i class="fas @iconClass"></i> @title</h4>
                </div>
                <div class="card-body">
                    <partial name="~/Views/Account/_ChangePasswordPartial.cshtml" model="Model" />
                </div>
                <div class="card-footer text-center">
                    <a href="@returnUrl" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left"></i> Retour
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    .card {
        border-radius: 15px;
        overflow: hidden;
    }

    .form-control:focus {
        border-color: @(isAdmin ? "#dc3545" : "#0d6efd");
        box-shadow: 0 0 0 0.25rem rgba( @(isAdmin ? "220, 53, 69" : "13, 110, 253"), 0.25);
    }

    .form-control-lg {
        padding: 12px 20px;
    }

    .btn-lg {
        padding: 12px 30px;
        font-size: 1.1rem;
    }

    .alert-warning {
        background-color: #fff3cd;
        border: 1px solid #ffecb5;
        color: #664d03;
    }
</style>