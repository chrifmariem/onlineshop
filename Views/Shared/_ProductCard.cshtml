@model onlineShop.DTOs.ProduitDTO

<div class="card product-card h-100 shadow-sm">
    @if (Model.APromotion)
    {
        <div class="position-absolute top-0 end-0 m-2">
            <span class="badge bg-danger">-@Model.PromoWeb%</span>
        </div>
    }

    @if (!Model.EstDisponible)
    {
        <div class="position-absolute top-0 start-0 m-2">
            <span class="badge bg-secondary">Rupture de stock</span>
        </div>
    }

    <a asp-controller="Produits" asp-action="Details" asp-route-id="@Model.Idproduit" class="text-decoration-none">
        <img src="@Model.Image" class="card-img-top product-image" alt="@Model.Design"
             onerror="this.src='/images/default-product.png'">
    </a>

    <div class="card-body d-flex flex-column">
        <h5 class="card-title text-truncate">@Model.Design</h5>
        <p class="text-muted small mb-2">
            <i class="fas fa-flask"></i> @Model.Labo
        </p>

        <div class="mt-auto">
            @if (Model.APromotion)
            {
                <div class="d-flex align-items-center gap-2 mb-2">
                    <span class="text-decoration-line-through text-muted">@Model.Ttc.ToString("F2") DT</span>
                    <span class="text-danger fw-bold fs-5">@Model.PrixApresPromo?.ToString("F2") DT</span>
                </div>
            }
            else
            {
                <p class="fw-bold fs-5 mb-2 text-primary">@Model.Ttc.ToString("F2") DT</p>
            }

            @if (Model.EstDisponible)
            {
                <div class="d-grid gap-2">
                    <form asp-controller="Produits" asp-action="AjouterAuPanier" method="post">
                        <input type="hidden" name="id" value="@Model.Idproduit" />
                        <input type="hidden" name="quantite" value="1" />
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-cart-plus"></i> Ajouter au panier
                        </button>
                    </form>
                    <a asp-controller="Produits" asp-action="Details" asp-route-id="@Model.Idproduit"
                       class="btn btn-outline-secondary btn-sm">
                        <i class="fas fa-info-circle"></i> Détails
                    </a>
                </div>
            }
            else
            {
                <button class="btn btn-secondary w-100" disabled>
                    <i class="fas fa-times-circle"></i> Indisponible
                </button>
            }
        </div>
    </div>
</div>