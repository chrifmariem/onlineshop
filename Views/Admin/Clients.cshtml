@model IEnumerable<onlineShop.DTOs.ClientDTO>
@{
    ViewData["Title"] = "Gestion des Clients";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="fas fa-users"></i> Gestion des Clients</h1>
        <a asp-action="Dashboard" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left"></i> Retour
        </a>
    </div>

    <div class="card shadow">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Nom</th>
                            <th>Email</th>
                            <th>Téléphone</th>
                            <th>Date d'inscription</th>
                            <th>Rôle</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in Model)
                        {
                            <tr>
                                <td>@client.Idclient</td>
                                <td>@client.NomComplet</td>
                                <td>@client.Email</td>
                                <td>@client.Telephone</td>
                                <td>@client.DateInscrip.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge bg-@(client.Role == "admin" ? "danger" : "primary")">
                                        @client.Role
                                    </span>
                                </td>
                                <td>
                                    <!-- Bouton Supprimer seulement -->
                                    <form method="post" asp-action="SupprimerClient" asp-route-id="@client.Idclient"
                                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer le client @client.NomComplet ?')"
                                          style="display: inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-danger" title="Supprimer">
                                            <i class="fas fa-trash"></i> Supprimer
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmation (optionnel) -->
<div class="modal fade" id="confirmationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmation de suppression</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Êtes-vous sûr de vouloir supprimer ce client ? Cette action est irréversible.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <button type="button" class="btn btn-danger" id="confirmDeleteBtn">Supprimer</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Script pour gérer la confirmation de suppression (optionnel)
        function confirmDelete(clientId, clientName) {
            if (confirm('Êtes-vous sûr de vouloir supprimer le client ' + clientName + ' ?')) {
                // Soumettre le formulaire correspondant
                document.getElementById('deleteForm-' + clientId).submit();
            }
        }
    </script>
}