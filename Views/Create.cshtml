@model onlineShop.DTOs.CreateCommandeDto
@{
    ViewData["Title"] = "Créer une commande";
}

<form asp-action="Create" method="post">
    <!-- Client Info -->
    <div class="mb-3">
        <label asp-for="Idclient" class="form-label">Client</label>
        <select asp-for="Idclient" class="form-select">
            <!-- Populate with clients -->
        </select>
        <span asp-validation-for="Idclient" class="text-danger"></span>
    </div>

    <!-- Delivery Address -->
    <div class="mb-3">
        <label asp-for="AdresseLivraison" class="form-label">Adresse de livraison</label>
        <textarea asp-for="AdresseLivraison" class="form-control" rows="3"></textarea>
        <span asp-validation-for="AdresseLivraison" class="text-danger"></span>
    </div>

    <!-- Delivery Phone -->
    <div class="mb-3">
        <label asp-for="TelephoneLivraison" class="form-label">Téléphone de livraison</label>
        <input asp-for="TelephoneLivraison" class="form-control" />
        <span asp-validation-for="TelephoneLivraison" class="text-danger"></span>
    </div>

    <!-- Payment Method -->
    <div class="mb-3">
        <label asp-for="ModePaiement" class="form-label">Mode de paiement</label>
        <select asp-for="ModePaiement" class="form-select">
            <option value="">-- Sélectionner --</option>
            <option value="Espèces">Espèces</option>
            <option value="Carte bancaire">Carte bancaire</option>
            <option value="Virement">Virement</option>
            <option value="Chèque">Chèque</option>
        </select>
        <span asp-validation-for="ModePaiement" class="text-danger"></span>
    </div>

    <!-- Status (optional) -->
    <div class="mb-3">
        <label asp-for="Statut" class="form-label">Statut</label>
        <select asp-for="Statut" class="form-select">
            <option value="En attente">En attente</option>
            <option value="Validée">Validée</option>
            <option value="Expédiée">Expédiée</option>
            <option value="Livrée">Livrée</option>
            <option value="Annulée">Annulée</option>
        </select>
        <span asp-validation-for="Statut" class="text-danger"></span>
    </div>

    <!-- Products -->
    <div class="mb-3">
        <label class="form-label">Produits</label>
        <!-- Add product selection here -->
    </div>

    <!-- Notes -->
    <div class="mb-3">
        <label asp-for="Notes" class="form-label">Notes</label>
        <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
        <span asp-validation-for="Notes" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Créer la commande</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}